# Vercel → Project → Settings → Environment Variables 에 같은 이름으로 넣으세요.
# (이 파일 자체는 예시일 뿐, 실제 키를 적어 커밋하지 마세요)

# [필수] 열린국회정보 인증키 — https://open.assembly.go.kr 회원가입 → 마이페이지 → 인증키 발급 (무료)
ASSEMBLY_API_KEY=

# [선택] Claude API 키 — 없으면 정책·법 소식이 원문만 나옵니다
ANTHROPIC_API_KEY=

# [선택] 요약 모델 (기본 claude-opus-5-5). 비용을 크게 줄이려면 claude-haiku-5-5
CLAUDE_MODEL=

# [선택] 청원 목록 서비스 코드 (기본 PTTRCP = 청원 접수목록)
#        열린국회정보에서 "진행중 국민동의청원 현황"의 서비스 코드를 넣으면 동의 진행 중인 청원이 나옵니다
PETITION_LIST_CODE=
# [선택] 청원 목록 추가 인자 (기본 ERACO=제22대)
PETITION_LIST_PARAMS=
# [선택] 청원 상세 서비스 코드 (기본 PTTINFODETAIL)
PETITION_DETAIL_CODE=

# [선택] 정부 정책 RSS 주소 (기본 https://www.korea.kr/rss/policy.xml)
POLICY_RSS_URL=
